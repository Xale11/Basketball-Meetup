{
  "cli": {
    "version": ">= 16.15.0",
    "appVersionSource": "remote"
  },
  "build": {
    "base": {
      "node": "20.18.0"
    },
    "development-basketball": {
      "extends": "base",
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "env": { "EXPO_PUBLIC_APP_VARIANT": "basketball", "APP_ENV": "development" },
      "android": { "buildType": "apk" }
    },
    "development-activcampus": {
      "extends": "base",
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "env": { "EXPO_PUBLIC_APP_VARIANT": "activCampus", "APP_ENV": "development" },
      "android": { "buildType": "apk" }
    },
    "preview-basketball": {
      "extends": "base",
      "distribution": "internal",
      "environment": "preview",
      "env": { "EXPO_PUBLIC_APP_VARIANT": "basketball", "APP_ENV": "preview" },
      "android": { "buildType": "apk" }
    },
    "preview-activcampus": {
      "extends": "base",
      "distribution": "internal",
      "environment": "preview",
      "env": { "EXPO_PUBLIC_APP_VARIANT": "activCampus", "APP_ENV": "preview" },
      "android": { "buildType": "apk" }
    },
    "production-basketball": {
      "extends": "base",
      "autoIncrement": true,
      "environment": "production",
      "env": { "EXPO_PUBLIC_APP_VARIANT": "basketball", "APP_ENV": "production" }
    },
    "production-activcampus": {
      "extends": "base",
      "autoIncrement": true,
      "environment": "production",
      "env": { "EXPO_PUBLIC_APP_VARIANT": "activCampus", "APP_ENV": "production" }
    }
  },
  "submit": {
    "production-basketball": {},
    "production-activcampus": {}
  }
}
